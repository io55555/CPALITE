-		t.Fatalf("Anthropic-Beta = %q, want the unknown body beta dropped", got)
+	if got := req.Header.Get("Anthropic-Beta"); got != "unknown-body-probe-2099-01-01" {
+		t.Fatalf("Anthropic-Beta = %q, want the caller body beta preserved", got)
 	}
 }
 
